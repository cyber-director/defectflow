# ============================================
# SUPABASE (public — safe to expose to the browser)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ============================================
# SUPABASE (server only — NEVER prefix with NEXT_PUBLIC_)
# ============================================
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# MODEL
# ============================================
NEXT_PUBLIC_MODEL_URL=/models/defect_detector.onnx
MODEL_PATH=models/defect_detector.onnx
MODEL_VERSION=1.0.0
NEXT_PUBLIC_MODEL_VERSION=1.0.0
# Informational only — the priority formula version is currently
# hardcoded in src/lib/priority/calculate.ts, not read from env.
PRIORITY_VERSION=extent-v1

# ============================================
# APP
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=DefectFlow

# ============================================
# DEMO STAFF SEED (used by scripts/seed-staff.ts — not read by the app)
# Numbering starts at 1 per category; add as many staff as you want by
# continuing the sequence (e.g. STRUCTURAL_STAFF_2_EMAIL, _3_, ...).
# ============================================
STRUCTURAL_STAFF_1_EMAIL=
STRUCTURAL_STAFF_1_PASSWORD=
STRUCTURAL_STAFF_1_NAME=
STRUCTURAL_STAFF_2_EMAIL=
STRUCTURAL_STAFF_2_PASSWORD=
STRUCTURAL_STAFF_2_NAME=

FUNCTIONAL_STAFF_1_EMAIL=
FUNCTIONAL_STAFF_1_PASSWORD=
FUNCTIONAL_STAFF_1_NAME=
FUNCTIONAL_STAFF_2_EMAIL=
FUNCTIONAL_STAFF_2_PASSWORD=
FUNCTIONAL_STAFF_2_NAME=

PERFORMANCE_STAFF_1_EMAIL=
PERFORMANCE_STAFF_1_PASSWORD=
PERFORMANCE_STAFF_1_NAME=
PERFORMANCE_STAFF_2_EMAIL=
PERFORMANCE_STAFF_2_PASSWORD=
PERFORMANCE_STAFF_2_NAME=
